{
  "name": "pursuit-simulator-rp-desktop",
  "version": "0.1.0",
  "description": "Pursuit Simulator - Randomized only (local desktop app)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "edu.ucsb.psych.pursuitsimulator.rp",
    "productName": "Pursuit Simulator RP",
    "files": ["main.js", "preload.js", "frontend-build/**/*"],
    "afterPack": "adhoc-sign.js",
    "extraResources": [
      { "from": "backend-dist", "to": "backend" }
    ],
    "win": { "target": "nsis" },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "identity": null,
      "artifactName": "Pursuit-Simulator-RP-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Pursuit-Simulator-RP-Setup-${version}.${ext}"
    }
  }
}
